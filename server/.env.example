PORT=3000

# Caminho opcional do SQLite (padrão: ./data/eleicao.db)
# SQLITE_PATH=./data/eleicao.db

# Origens CORS separadas por vírgula
# CORS_ORIGINS=http://localhost:4200

# Assistente opcional: configure a chave no servidor, nunca no navegador.
# No nivel gratuito, perguntas podem ser usadas pelo Google para melhorar os produtos.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
